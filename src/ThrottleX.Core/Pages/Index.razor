@page "/"
@inject WifredClientStore ClientStore
@inject LoconetService LoconetService
@inject ISystemHealthService HealthService
@implements IDisposable

<PageTitle>ThrottleX - Dashboard</PageTitle>

<div class="row g-3 mb-4">
    <!-- Stat 1: WiFred Clients -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-body-secondary small fw-medium text-uppercase tracking-wider">WiFred Clients</span>
                    <h2 class="mb-0 fw-bold mt-1">@OnlineClientsCount <span class="fs-6 text-body-secondary fw-normal">/ @TotalClientsCount</span></h2>
                    <div class="small mt-1 text-success d-flex align-items-center gap-1">
                        <span class="status-dot status-dot-success"></span>
                        @OnlineClientsCount Online
                    </div>
                </div>
                <div class="stat-icon-wrapper bg-primary-subtle text-primary rounded-3 p-3">
                    <WifredIcon Size="24"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 2: Controlled Locos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-body-secondary small fw-medium text-uppercase tracking-wider">Active Locomotives</span>
                    <h2 class="mb-0 fw-bold mt-1">@ActiveLocosCount</h2>
                    <div class="small mt-1 text-body-secondary">
                        Under active throttle control
                    </div>
                </div>
                <div class="stat-icon-wrapper bg-info-subtle text-info rounded-3 p-3">
                    <TrainIcon Size="24"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 3: LocoNet Status -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <span class="text-body-secondary small fw-medium text-uppercase tracking-wider">LocoNet Over TCP</span>
                    <h2 class="mb-0 fw-bold mt-1">@OperationalLoconetCount <span class="fs-6 text-body-secondary fw-normal">/ @TotalLoconetCount</span></h2>
                    <div class="small mt-1 d-flex align-items-center gap-1 @(OperationalLoconetCount > 0 ? "text-success" : "text-warning")">
                        <span class="status-dot @(OperationalLoconetCount > 0 ? "status-dot-success" : "status-dot-warning")"></span>
                        @(OperationalLoconetCount > 0 ? "Connected & Ready" : "Disconnected / Retrying")
                    </div>
                </div>
                <div class="stat-icon-wrapper bg-success-subtle text-success rounded-3 p-3">
                    <LoconetIcon Size="24" Style="@LoconetIcon.LoconetIconStyle.Filled"/>
                </div>
            </div>
        </div>
    </div>

    <!-- Stat 4: System Health -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex flex-column justify-content-between p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-body-secondary small fw-medium text-uppercase tracking-wider">System Health</span>
                        <h2 class="mb-0 fw-bold mt-1">@HealthMetrics.FormattedCpuUsage <span class="fs-6 text-body-secondary fw-normal">CPU</span></h2>
                    </div>
                    <div class="stat-icon-wrapper bg-secondary-subtle text-secondary rounded-3 p-3">
                        <ShieldIcon/>
                    </div>
                </div>
                <div class="small mt-2 pt-2 border-top d-flex flex-column gap-1 text-body-secondary">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Memory:</span>
                        <span class="fw-semibold text-body">@HealthMetrics.FormattedMemoryUsage <span class="fw-normal text-body-secondary">(@HealthMetrics.FormattedMemoryDetailed)</span></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>App Memory:</span>
                        <span class="fw-semibold text-body">@HealthMetrics.FormattedProcessMemory</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>App CPU (1/5/15m):</span>
                        <span class="fw-semibold text-body">@HealthMetrics.FormattedAppCpuUsage</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Network:</span>
                        <span class="fw-semibold text-body">@HealthMetrics.FormattedNetworkRate</span>
                    </div>
                    @if (HealthMetrics.CpuTemperatureCelsius.HasValue)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <span>CPU Temp:</span>
                            <span class="fw-semibold text-body">@HealthMetrics.FormattedCpuTemperature</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Quick WiFred Clients Summary -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-2 bg-primary-subtle text-primary rounded-2">
                        <WifredIcon Size="16"/>
                    </span>
                    <h5 class="card-title mb-0 fw-semibold">WiFred Throttles</h5>
                    <div class="small mt-1 text-body-secondary">5 most recently connected</div>
                </div>
                <a href="/wifred-clients" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Clients.Any())
                {
                    <div class="text-center py-5 text-body-secondary">
                        <p class="mb-0">No WiFred clients registered yet.</p>
                        <small>Throttles will appear here automatically when connected.</small>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var client in Clients.Take(5))
                        {
                            <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center p-3 gap-2">
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <h6 class="mb-0 fw-bold">@client.Name</h6>
                                        <StatusBadge IsActive="@client.IsConnected" Text="@(client.IsConnected ? "Online" : "Offline")"/>
                                    </div>
                                    <div class="small text-body-secondary mt-1 d-flex flex-wrap gap-2 align-items-center">
                                        <span>UID: <code>@client.Id</code></span>
                                        @if (!string.IsNullOrEmpty(client.GetIpAddress()))
                                        {
                                            <span>&bull;</span>
                                            <span>IP:
                                                @if (!string.IsNullOrEmpty(client.GetIpAddress()))
                                                {
                                                    <a href="http://@client.GetIpAddress()" target="_blank" rel="noopener noreferrer" class="fw-medium text-decoration-none">
                                                        @client.GetIpAddress()
                                                        <ExternalLinkIcon/>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-body-secondary">N/A</span>
                                                }
                                                </span>
                                        }
                                        @if (!string.IsNullOrEmpty(client.GetLocoAdresses()))
                                        {
                                            <span>&bull;</span>
                                            <span class="badge bg-primary-subtle text-primary-emphasis">Locos: @client.GetLocoAdresses()</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <BatteryIndicator Millivolts="@client.BatteryVoltage"/>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- LocoNet Links Summary -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="p-2 bg-success-subtle text-success rounded-2">
                        <LoconetIcon Size="16"/>
                    </span>
                    <h5 class="card-title mb-0 fw-semibold">LocoNet Connections</h5>
                </div>
                <a href="/loconet-connections" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!LoconetService.Clients.Any())
                {
                    <div class="text-center py-5 text-body-secondary">
                        <p class="mb-0">No LocoNet endpoints configured.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var (client, send) in LoconetService.Clients)
                        {
                            <div class="list-group-item p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-bold">@client.PeerName</div>
                                    <StatusBadge IsActive="@client.IsOperational" Text="@client.State.ToString()"/>
                                </div>
                                <div class="small text-body-secondary d-flex flex-column gap-1 mt-2">
                                    <div><strong>Send Thread:</strong> @send.State</div>
                                    @if (send.GuessedCommandStation != null)
                                    {
                                        <div><strong>Command Station:</strong> <span class="badge bg-secondary-subtle text-secondary-emphasis">@send.GuessedCommandStation</span></div>
                                    }
                                    @if (!string.IsNullOrEmpty(client.ServerVersionInfo))
                                    {
                                        <div><strong>Server:</strong> @client.ServerVersionInfo</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
