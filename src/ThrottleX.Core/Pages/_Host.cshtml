@page "/"
@namespace ThrottleX.Core.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ThrottleX Dashboard</title>
    <base href="~/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="ThrottleX.Core.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
</head>
<body class="bg-body text-body">
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui" class="alert alert-danger fixed-bottom m-3 shadow-lg d-none" role="alert">
        <span>An unhandled error has occurred.</span>
        <a href="" class="reload btn btn-sm btn-outline-danger ms-2">Reload</a>
        <a class="dismiss btn-close float-end" aria-label="Close"></a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/site.js" asp-append-version="true"></script>
</body>
</html>
