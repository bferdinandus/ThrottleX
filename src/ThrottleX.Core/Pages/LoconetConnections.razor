@page "/loconet-connections"
@inject LoconetService LoconetService
@implements IDisposable

<PageTitle>ThrottleX - LocoNet Connections</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <span class="p-2 bg-success-subtle text-success rounded-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-hdd-network" viewBox="0 0 16 16">
                    <path d="M4.5 5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zM3 4.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"/>
                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H8.5v3a1.5 1.5 0 0 1 1.5 1.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-1-.5V11h-2v1.5a.5.5 0 0 1-1 .5h-1a.5.5 0 0 1 0-1h1A1.5 1.5 0 0 1 7.5 10V7H2a2 2 0 0 1-2-2V4zm1 0v1a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1zm6 7.5v1a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0z"/>
                </svg>
            </span>
            LocoNet Connections
        </h2>
        <p class="text-body-secondary mb-0">Monitor LocoNetOverTcp connections, gateway send threads, and command station detection.</p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-body-tertiary text-body border px-3 py-2">
            <strong>@OperationalCount</strong> / <strong>@TotalCount</strong> Operational
        </span>
    </div>
</div>

@if (!LoconetService.Clients.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <div class="text-body-tertiary mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-hdd-network" viewBox="0 0 16 16">
                    <path d="M4.5 5a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1zM3 4.5a.5.5 0 1 1-1 0 .5.5 0 0 1 1 0z"/>
                    <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1a2 2 0 0 1-2 2H8.5v3a1.5 1.5 0 0 1 1.5 1.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-1-.5V11h-2v1.5a.5.5 0 0 1-1 .5h-1a.5.5 0 0 1 0-1h1A1.5 1.5 0 0 1 7.5 10V7H2a2 2 0 0 1-2-2V4zm1 0v1a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H2a1 1 0 0 0-1 1zm6 7.5v1a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0z"/>
                </svg>
            </div>
            <h5 class="fw-semibold">No LocoNet Connections Configured</h5>
            <p class="text-body-secondary">Configure LocoNet client endpoints in <code>appsettings.json</code> to connect to LocoNet over TCP.</p>
        </div>
    </div>
}
else
{
    <!-- Mobile Card View -->
    <div class="d-block d-md-none">
        <div class="row g-3">
            @foreach (var (client, send) in LoconetService.Clients)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title fw-bold mb-0">@client.PeerName</h5>
                                <StatusBadge IsActive="@client.IsOperational" Text="@client.State.ToString()" />
                            </div>

                            <div class="d-flex flex-column gap-2 my-3 p-2 rounded bg-body-tertiary small">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Host:</span>
                                    <code>@client.Host</code>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Port:</span>
                                    <span>@client.Port</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Send Thread:</span>
                                    <span class="badge @(send.State == LoconetSend.EState.NormalOperation ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                        @send.State
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Command Station:</span>
                                    @if (send.GuessedCommandStation != null)
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis">@send.GuessedCommandStation</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">Detecting...</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Server Version:</span>
                                    <span class="text-body-secondary">@(client.ServerVersionInfo ?? "Unknown")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Desktop Table View -->
    <div class="card border-0 shadow-sm d-none d-md-block overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-body-secondary small text-uppercase">
                    <tr>
                        <th scope="col" style="width: 120px;">Status</th>
                        <th scope="col">Peer (Host:Port)</th>
                        <th scope="col">Client State</th>
                        <th scope="col">Send Thread</th>
                        <th scope="col">Command Station</th>
                        <th scope="col">Server Version</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var (client, send) in LoconetService.Clients)
                    {
                        <tr>
                            <td>
                                <StatusBadge IsActive="@client.IsOperational" Text="@(client.IsOperational ? "Connected" : client.State.ToString())" />
                            </td>
                            <td>
                                <span class="fw-bold">@client.PeerName</span>
                            </td>
                            <td>
                                <span class="badge bg-body-secondary text-body">@client.State</span>
                            </td>
                            <td>
                                <span class="badge @(send.State == LoconetSend.EState.NormalOperation ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                    @send.State
                                </span>
                            </td>
                            <td>
                                @if (send.GuessedCommandStation != null)
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis">@send.GuessedCommandStation</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary small">Detecting...</span>
                                }
                            </td>
                            <td class="small text-body-secondary">
                                @(client.ServerVersionInfo ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private int TotalCount => LoconetService.Clients.Count();
    private int OperationalCount => LoconetService.Clients.Count(c => c.client.IsOperational);

    protected override void OnInitialized()
    {
        LoconetService.OnConnectionsChanged += HandleConnectionsChanged;
    }

    private void HandleConnectionsChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LoconetService.OnConnectionsChanged -= HandleConnectionsChanged;
    }
}
