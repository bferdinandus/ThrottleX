@page "/wifred-clients"
@inject WifredClientStore ClientStore
@implements IDisposable

<PageTitle>ThrottleX - WiFred Clients</PageTitle>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
            <span class="p-2 bg-primary-subtle text-primary rounded-3">
                <WifredIcon Size="22" />
            </span>
            WiFred Clients
        </h2>
        <p class="text-body-secondary mb-0">Manage connected WiFred throttles and monitor live battery telemetry.</p>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="input-group search-input-group">
            <span class="input-group-text bg-body border-end-0">
                <SearchIcon />
            </span>
            <input type="text" class="form-control border-start-0 ps-0" placeholder="Filter by name, UID, loco..." @bind="_searchTerm" @bind:event="oninput" />
            @if (!string.IsNullOrEmpty(_searchTerm))
            {
                <button class="btn btn-outline-secondary border-start-0" type="button" @onclick="() => _searchTerm = string.Empty">
                    &times;
                </button>
            }
        </div>
    </div>
</div>

@if (!FilteredClients.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <div class="text-body-tertiary mb-3">
                <InboxIcon />
            </div>
            @if (string.IsNullOrEmpty(_searchTerm))
            {
                <h5 class="fw-semibold">No WiFred Clients Connected</h5>
                <p class="text-body-secondary">Once a WiFred throttle connects to this gateway, it will appear here in real-time.</p>
            }
            else
            {
                <h5 class="fw-semibold">No Matching Clients</h5>
                <p class="text-body-secondary">No client matched your filter "<strong>@_searchTerm</strong>".</p>
                <button class="btn btn-sm btn-outline-primary" @onclick="() => _searchTerm = string.Empty">Clear Filter</button>
            }
        </div>
    </div>
}
else
{
    <!-- Mobile Card View (shown on screens < md) -->
    <div class="d-block d-md-none">
        <div class="row g-3">
            @foreach (var client in FilteredClients)
            {
                <div class="col-12">
                    <div class="card client-card border-0 shadow-sm h-100">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="card-title fw-bold mb-0">@client.Name</h5>
                                    <div class="text-body-secondary small">UID: <code>@client.Id</code></div>
                                </div>
                                <StatusBadge IsActive="@client.IsConnected" Text="@(client.IsConnected ? "Online" : "Offline")" />
                            </div>

                            <div class="d-flex flex-column gap-2 my-3 p-2 rounded bg-body-tertiary small">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">IP Address:</span>
                                    @if (!string.IsNullOrEmpty(client.GetIpAddress()))
                                    {
                                        <a href="http://@client.GetIpAddress()" target="_blank" rel="noopener noreferrer" class="fw-medium text-decoration-none">
                                            @client.GetIpAddress()
                                            <ExternalLinkIcon />
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">N/A</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Battery:</span>
                                    <BatteryIndicator Millivolts="@client.BatteryVoltage" />
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Locos:</span>
                                    @if (!string.IsNullOrEmpty(client.GetLocoAdresses()))
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis">@client.GetLocoAdresses()</span>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">None</span>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-body-secondary">Last Message:</span>
                                    <span>@(client.LastMessage != default ? client.LastMessage.ToString("HH:mm:ss") : "Never")</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" @onclick="() => ForgetClient(client.Id)" title="Disconnect and forget client">
                                    <TrashCanIcon size="14" />
                                    Forget
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Desktop Table View (shown on screens >= md) -->
    <div class="card border-0 shadow-sm d-none d-md-block overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-body-secondary small text-uppercase">
                    <tr>
                        <th scope="col" style="width: 100px;">Status</th>
                        <th scope="col">Name</th>
                        <th scope="col">UID</th>
                        <th scope="col">IP Address</th>
                        <th scope="col">Battery</th>
                        <th scope="col">Locos</th>
                        <th scope="col">Connected</th>
                        <th scope="col">Last Activity</th>
                        <th scope="col" class="text-end" style="width: 100px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in FilteredClients)
                    {
                        <tr>
                            <td>
                                <StatusBadge IsActive="@client.IsConnected" Text="@(client.IsConnected ? "Online" : "Offline")" />
                            </td>
                            <td>
                                <span class="fw-bold text-body">@client.Name</span>
                            </td>
                            <td>
                                <code>@client.Id</code>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(client.GetIpAddress()))
                                {
                                    <a href="http://@client.GetIpAddress()" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                        @client.GetIpAddress()
                                        <ExternalLinkIcon />
                                    </a>
                                }
                                else
                                {
                                    <span class="text-body-secondary">&mdash;</span>
                                }
                            </td>
                            <td>
                                <BatteryIndicator Millivolts="@client.BatteryVoltage" />
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(client.GetLocoAdresses()))
                                {
                                    <span class="badge bg-primary-subtle text-primary-emphasis">@client.GetLocoAdresses()</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary">&mdash;</span>
                                }
                            </td>
                            <td class="small text-body-secondary">
                                @(client.ConnectedAt.HasValue ? client.ConnectedAt.Value.ToString("HH:mm:ss") : "—")
                            </td>
                            <td class="small text-body-secondary">
                                @(client.LastMessage != default ? client.LastMessage.ToString("HH:mm:ss") : "—")
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" @onclick="() => ForgetClient(client.Id)" title="Disconnect and forget client">
                                    <TrashCanIcon size="14" />
                                    Forget
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
