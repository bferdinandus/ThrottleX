@model ThrottleX.Core.Pages.Components.WiFredClients
<div class="hydro-component">
    <caption>WiFred clients</caption>
    <table>
        <tr>
            <th>Name</th>
            <th>uid</th>
            <th>loco(s)</th>
            <th>last message at</th>
            <th>status</th>
            <th>IpAddress</th>
            <th>connected at</th>
        </tr>
        @foreach(var client in Model.Clients)
        {
            <tr>
                <td>@client.Name</td>
                <td>@client.Uid</td>
                <td>@client.Locos</td>
                <td>@client.LastMessage.ToLocalTime()</td>
                <td>@client.Status</td>
                <td><a href="http://@client.IpAddress" target="_blank">@client.IpAddress</a></td>
                <td>
                    @if (client.ConnectedAt.HasValue)
                    {
                        @client.ConnectedAt.Value.ToLocalTime()
                    }
                </td>
            </tr>
        }
    </table>
    <div>@Model.TestString</div>
    <div>
        Add fake client:
        <button hydro-on:click="@(() => Model.Add())">
            Add
        </button>
    </div>
</div>
