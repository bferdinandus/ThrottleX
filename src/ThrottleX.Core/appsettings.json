{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.Extensions": "Information",
      "System.Net.Http.HttpClient": "Information"
        
    }
  },
  "Loconet": {
    "Clients": [
      {
        "Host": "localhost",
        "Port": "1234"
      }
    ]
